{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "key": "",
  "name": "VideoLens AI",
  "version": "0.1.0",
  "description": "A video learning assistant that answers questions with the current YouTube or Bilibili context, transcript, and frame.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open VideoLens AI"
  },
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "commands": {
    "toggle-assistant": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open VideoLens AI for the current video"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*"
      ],
      "js": [
        "src/content/content_script.js"
      ],
      "css": [
        "src/content/content_styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/sidepanel/index.html",
        "src/sidepanel/sidepanel.css",
        "src/sidepanel/sidepanel.js"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*"
      ]
    }
  ]
}
